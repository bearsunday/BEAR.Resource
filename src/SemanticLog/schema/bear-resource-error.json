{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bear-resource-error.json",
  "title": "BEAR Resource Error",
  "description": "Schema for BEAR Resource error logging",
  "type": "object",
  "properties": {
    "uri": {
      "type": "string",
      "description": "The resource URI (e.g., app://self/user/profile)"
    },
    "method": {
      "type": "string",
      "description": "The HTTP method (GET, POST, PUT, DELETE, etc.)"
    },
    "exceptionClass": {
      "type": "string",
      "description": "The fully qualified class name of the exception"
    },
    "exceptionMessage": {
      "type": "string",
      "description": "The exception message"
    }
  },
  "required": ["uri", "method", "exceptionClass", "exceptionMessage"]
}