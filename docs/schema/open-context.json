{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bearsunday.github.io/BEAR.Resource/schemas/open-context.json",
  "title": "BEAR Resource Request (Compact)",
  "description": "Compact schema for BEAR Resource request logging - minimal information for production",
  "links": [
    {
      "rel": "https://bearsunday.github.io/BEAR.Resource/docs/link-relations#ai-docs",
      "title": "BEAR.Resource Framework Overview for AI",
      "href": "https://bearsunday.github.io/BEAR.Resource/docs/llms.txt"
    },
    {
      "rel": "service-doc",
      "title": "BEAR.Resource Complete Documentation", 
      "href": "https://bearsunday.github.io/BEAR.Resource/docs/llms-full.txt"
    },
    {
      "rel": "about",
      "title": "BEAR.Resource Project",
      "href": "https://bearsunday.github.io/BEAR.Resource/"
    }
  ],
  "type": "object",
  "properties": {
    "method": {
      "type": "string", 
      "description": "The HTTP method (GET, POST, PUT, DELETE, etc.)"
    },
    "uri": {
      "type": "string",
      "description": "The resource URI (e.g., app://self/user/profile)"
    },
    "profile": {
      "type": "object",
      "description": "Profile information containing XHProf, Xdebug, and PHP profiling data",
      "properties": {
        "xhprof": {
          "oneOf": [
            {"type": "object"},
            {"type": "array"}
          ],
          "description": "XHProf profiling data object, or empty array if not available"
        },
        "xdebug": {
          "oneOf": [
            {"type": "object"},
            {"type": "array"}
          ],
          "description": "Xdebug trace data object, or empty array if not available"
        },
        "php": {
          "type": "object",
          "description": "PHP profiling data with filtered backtrace focusing on user code",
          "properties": {
            "backtrace": {
              "type": "array",
              "description": "Filtered PHP backtrace focusing on user code"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["method", "uri"],
  "additionalProperties": true
}