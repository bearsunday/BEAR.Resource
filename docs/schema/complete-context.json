{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bearsunday.github.io/BEAR.Resource/schemas/complete-context.json",
  "title": "BEAR Resource Complete (Compact)",
  "description": "Compact schema for BEAR Resource completion logging - essential response information",
  "links": [
    {
      "rel": "https://bearsunday.github.io/BEAR.Resource/docs/link-relations#ai-docs",
      "title": "BEAR.Resource Framework Overview for AI",
      "href": "https://bearsunday.github.io/BEAR.Resource/docs/llms.txt"
    },
    {
      "rel": "service-doc", 
      "title": "BEAR.Resource Complete Documentation",
      "href": "https://bearsunday.github.io/BEAR.Resource/docs/llms-full.txt"
    },
    {
      "rel": "about",
      "title": "BEAR.Resource Project",
      "href": "https://bearsunday.github.io/BEAR.Resource/"
    }
  ],
  "type": "object",
  "properties": {
    "uri": {
      "type": "string",
      "description": "The resource URI for correlation with open context"
    },
    "code": {
      "type": "integer",
      "description": "The HTTP status code of the response"
    },
    "headers": {
      "type": "object",
      "description": "The response headers"
    },
    "body": {
      "oneOf": [
        {"type": "object"},
        {"type": "array"},
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"}
      ],
      "description": "The response body from the resource (can be any type)"
    },
    "view": {
      "type": "string",
      "description": "The rendered view as string"
    },
    "profile": {
      "type": "object",
      "description": "Profile information containing XHProf, Xdebug, and PHP profiling data",
      "properties": {
        "xhprof": {
          "oneOf": [
            {"type": "object"},
            {"type": "array"}
          ],
          "description": "XHProf profiling data object with file property, or empty array if not available"
        },
        "xdebug": {
          "oneOf": [
            {"type": "object"},
            {"type": "array"}
          ],
          "description": "Xdebug trace data object with file property, or empty array if not available"
        },
        "php": {
          "type": "object",
          "description": "PHP profiling data with filtered backtrace focusing on user code",
          "properties": {
            "backtrace": {
              "type": "array",
              "description": "Filtered PHP backtrace focusing on user code"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["uri", "code"],
  "additionalProperties": true
}