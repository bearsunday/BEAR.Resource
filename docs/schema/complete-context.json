{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/Users/akihito/git/BEAR.Resource/docs/schema/complete-context.json",
  "title": "BEAR Resource Complete (Compact)",
  "description": "Compact schema for BEAR Resource completion logging - essential response information",
  "links": [
    {
      "rel": "https://bearsunday.github.io/BEAR.Resource/docs/link-relations#ai-docs",
      "title": "BEAR.Resource Framework Overview for AI",
      "href": "/Users/akihito/git/BEAR.Resource/docs/llms.txt"
    },
    {
      "rel": "service-doc", 
      "title": "BEAR.Resource Complete Documentation",
      "href": "/Users/akihito/git/BEAR.Resource/docs/llms-full.txt"
    },
    {
      "rel": "about",
      "title": "BEAR.Resource Project",
      "href": "https://bearsunday.github.io/BEAR.Resource/"
    }
  ],
  "type": "object",
  "properties": {
    "uri": {
      "type": "string",
      "description": "The resource URI for correlation with open context"
    },
    "code": {
      "type": "integer",
      "description": "The HTTP status code of the response"
    },
    "headers": {
      "type": "object",
      "description": "The response headers"
    },
    "body": {
      "oneOf": [
        {"type": "object"},
        {"type": "array"},
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"}
      ],
      "description": "The response body from the resource (can be any type)"
    },
    "view": {
      "type": "string",
      "description": "The rendered view as string"
    },
    "xhprof_file": {
      "type": ["string", "null"],
      "description": "Path to XHProf profiling data file (optional)"
    },
    "xdebug_trace_file": {
      "type": ["string", "null"],
      "description": "Path to Xdebug trace file for detailed execution flow (optional)"
    }
  },
  "required": ["uri", "code"],
  "additionalProperties": true
}