{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(composer sa:*)",
      "Bash(./vendor/bin/psalm:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(composer pcov:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(composer test:*)",
      "Bash(rm:*)",
      "Bash(composer coverage:*)",
      "WebFetch(domain:github.com)",
      "Bash(mkdir:*)",
      "Bash(composer:*)",
      "Bash(mv:*)",
      "Bash(open:*)",
      "Bash(php:*)",
      "Bash(cp:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(composer install:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(composer update:*)",
      "Bash(php:*)",
      "Bash(composer cs-fix:*)",
      "Bash(composer tests:*)",
      "Bash(mv:*)",
      "Bash(composer test:*)",
      "Bash(composer:*)",
      "WebFetch(domain:github.com)",
      "Bash(XDEBUG_MODE=debug,trace ./vendor/bin/phpunit tests/SemanticLogVerboseProfileTest.php)",
      "Bash(XDEBUG_MODE=debug,trace ./vendor/bin/phpunit tests/SemanticLogVerboseProfileTest.php --filter testVerboseContextFactory)",
      "Bash(XDEBUG_MODE=debug,trace ./vendor/bin/phpunit tests/SemanticLogVerboseProfileTest.php --filter testXdebugIntegrationWhenAvailable)",
      "Bash(XDEBUG_MODE=debug,trace ./vendor/bin/phpunit tests/SemanticLogVerboseProfileTest.php --filter \"testVerboseContextFactory|testXdebugIntegrationWhenAvailable\")",
      "Bash(grep:*)",
      "Bash(gunzip:*)",
      "Bash(XDEBUG_MODE=coverage ./vendor/bin/phpunit tests/SemanticLogVerboseProfileTest.php --coverage-text)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(XDEBUG_MODE=trace composer test)",
      "Bash(XDEBUG_MODE=trace php --ri xdebug)",
      "Bash(XDEBUG_MODE=trace php -r \"echo ''xdebug.compression_level: '' . ini_get(''xdebug.compression_level'') . PHP_EOL;\")",
      "Bash(gh pr view:*)"
    ],
    "deny": []
  }
}