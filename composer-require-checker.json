{
  "symbol-whitelist": [
    "null", "true", "false",
    "static", "self", "parent",
    "array", "string", "int", "float", "bool", "iterable", "callable", "void", "object",
    "Attribute", "ReflectionAttribute", "Stringable",
    "BEAR\\Resource\\HalLink", "BEAR\\Resource\\NullReverseLink", "BEAR\\Resource\\ReverseLinkInterface", "BEAR\\Resource\\Module\\AnnotationModule",
    "JSONSchemaFaker\\Faker",
    "xdebug_start_trace", "xdebug_stop_trace",
    "xhprof_enable", "xhprof_disable", "xdebug_get_tracefile_name",
    "XHPROF_FLAGS_CPU", "XHPROF_FLAGS_MEMORY", "XHPROF_FLAGS_NO_BUILTINS"
  ]
}
