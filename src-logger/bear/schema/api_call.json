{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "API Call Schema",
  "description": "Schema for API call metadata in BEAR applications",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "description": "API endpoint path",
      "pattern": "^/.*"
    },
    "method": {
      "type": "string",
      "description": "HTTP method",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    },
    "request_size": {
      "type": "integer",
      "description": "Request payload size in bytes",
      "minimum": 0
    },
    "response_code": {
      "type": "integer",
      "description": "HTTP response status code",
      "minimum": 100,
      "maximum": 599
    },
    "client_ip": {
      "type": "string",
      "description": "Client IP address",
      "format": "ipv4"
    },
    "user_agent": {
      "type": "string",
      "description": "Client User-Agent header"
    }
  },
  "required": ["endpoint", "method"],
  "additionalProperties": false
}