{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BEAR Resource Request Schema",
  "description": "Schema for BEAR resource request metadata",
  "type": "object",
  "properties": {
    "uri": {
      "type": "string",
      "description": "Resource URI (e.g., app://self/user)",
      "pattern": "^[a-z]+://.*"
    },
    "method": {
      "type": "string",
      "description": "HTTP method",
      "enum": ["get", "post", "put", "patch", "delete", "head", "options"]
    },
    "query": {
      "type": "object",
      "description": "Query parameters passed to the resource",
      "additionalProperties": true
    },
    "type": {
      "type": "string",
      "description": "Type of request",
      "const": "resource_request"
    }
  },
  "required": ["uri", "method", "type"],
  "additionalProperties": false
}