{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Database Query Schema",
  "description": "Schema for database query metadata",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "SQL query string"
    },
    "parameters": {
      "type": "array",
      "description": "Query parameters",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "execution_time": {
      "type": "number",
      "description": "Query execution time in seconds",
      "minimum": 0
    },
    "affected_rows": {
      "type": "integer",
      "description": "Number of affected rows",
      "minimum": 0
    },
    "database": {
      "type": "string",
      "description": "Database name"
    },
    "table": {
      "type": "string",
      "description": "Primary table involved in the query"
    }
  },
  "required": ["query"],
  "additionalProperties": false
}